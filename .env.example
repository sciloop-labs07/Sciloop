SCILOOP_AI_BACKEND_URL=http://localhost:5050
POSSIBILITY_ENABLE_FORLOOP_BACKEND=true
FORLOOP_BACKEND_URL=http://localhost:3001
SCILOOP_MAIN_URL=http://localhost:3010
FORLOOP_WORKFLOW_ACCESS_CODE=123456
FORLOOP_QP_TIMEOUT_MS=30000
NEXT_PUBLIC_SCILOOP_AI_API_BASE=/api/sciloop-ai-proxy
NEXT_PUBLIC_SITE_URL=http://localhost:3000
OPENAI_API_KEY=
OPENAI_STREAM_MODEL=gpt-5
OPENAI_POSSIBILITY_MODEL=gpt-4o-mini

# Quantum Possibilities Engine (server-only provider routing)
AI_PROVIDER=auto
# Main-app fallback order. The ForLoop backend performs the verified provider loop.
POSSIBILITY_PROVIDER_ORDER=forloop,gemini
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
TOGETHER_API_KEY=
TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=Qwen/Qwen2.5-72B-Instruct
COHERE_API_KEY=
COHERE_MODEL=command-r-plus-08-2024
POSSIBILITY_AI_TIMEOUT_MS=12000
POSSIBILITY_ENABLE_OLLAMA=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Production example:
# SCILOOP_AI_BACKEND_URL=https://your-sciloop-ai-backend.onrender.com
# FORLOOP_BACKEND_URL=https://your-forloop-backend.onrender.com
# SCILOOP_MAIN_URL=https://your-domain.com
# FORLOOP_WORKFLOW_ACCESS_CODE=change-me
# NEXT_PUBLIC_SCILOOP_AI_API_BASE=/api/sciloop-ai-proxy
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Render sharing example:
# FRONTEND_ORIGIN=https://your-frontend.onrender.com
# FORLOOP_ALLOWED_ORIGIN=https://your-frontend.onrender.com
# VISUAL_LANGUAGE_LAB_URL=https://your-frontend.onrender.com/visual-language-lab
# FORLOOP_DEV_ACCESS_CODE=change-me
