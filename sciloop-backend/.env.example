PORT=5050
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:3000
VISUAL_LANGUAGE_LAB_URL=http://localhost:3000/visual-language-lab
NEWS_VISUALIZE_HANDOFF_TTL_MS=900000

# Production example:
# FRONTEND_ORIGIN=https://your-domain.com
# VISUAL_LANGUAGE_LAB_URL=https://your-domain.com/visual-language-lab

# AI providers - user adds only keys they legally own
GEMINI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
COHERE_API_KEY=
WIT_AI_TOKEN=
HUGGINGFACE_API_KEY=
STABILITY_API_KEY=
CLARIFAI_PAT=
ASSEMBLYAI_API_KEY=
GITHUB_TOKEN=
OPENROUTER_API_KEY=
TOGETHER_API_KEY=
OPENAI_API_KEY=

# Optional model overrides
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_MODEL=openrouter/free
GROQ_MODEL=llama-3.1-8b-instant
DEEPSEEK_MODEL=deepseek-chat
COHERE_EMBED_MODEL=embed-v4.0
COHERE_CHAT_MODEL=command-a-03-2025
HUGGINGFACE_MODEL=mistralai/Mistral-7B-Instruct-v0.3
GITHUB_MODELS_BASE_URL=https://models.github.ai/inference
TOGETHER_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct-Turbo
OPENAI_VISUAL_MODEL=gpt-5-mini
OPENAI_VISUAL_TIMEOUT_MS=15000
OPENAI_VISUAL_MAX_TOKENS=1400

# News providers - user adds only keys they legally own
NEWSAPI_KEY=
GNEWS_API_KEY=
GUARDIAN_API_KEY=
NYT_API_KEY=
MEDIASTACK_API_KEY=
NASA_API_KEY=

# Safety limits
DEFAULT_TIMEOUT_MS=12000
AI_PROVIDER_TIMEOUT_MS=15000
MAX_PROVIDERS_PER_AI_REQUEST=5
NEWS_CACHE_TTL_SECONDS=900
AI_CACHE_TTL_SECONDS=604800
MAX_ARTICLES_PER_REQUEST=12
MAX_AI_CALLS_PER_REQUEST=4
